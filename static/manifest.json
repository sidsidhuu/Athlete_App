{
  "name": "SSA",
  "short_name": "SSA",
  "description": "Smart Sports Analytics — AI-powered performance tracking and athlete insights.",
  "start_url": "https://athlete-app-jphm.onrender.com",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen"],
  "background_color": "#ffffff",
  "theme_color": "#000000",
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "scope": "/",
  "categories": ["sports", "health", "fitness", "analytics"],

  "icons": [
    {
      "src": "/static/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/static/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],

  "shortcuts": [
    {
      "name": "View Dashboard",
      "short_name": "Dashboard",
      "url": "/dashboard",
      "icons": [{ "src": "/static/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Performance",
      "short_name": "Performance",
      "url": "/performance"
    }
  ],

  "protocol_handlers": [
    {
      "protocol": "ssa",
      "url": "/profile?user=%s"
    }
  ],

  "launch_handler": {
    "client_mode": "auto"
  },

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["image/*"] }]
    }
  },

  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.ssa.app",
      "id": "com.ssa.app"
    }
  ],

  "prefer_related_applications": false
}
