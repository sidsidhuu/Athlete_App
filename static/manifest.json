{
  "name": "SSA",
  "short_name": "SSA",
  "description": "Smart Sports Athlete — AI-powered performance tracking and athlete insights.",
  "start_url": "https://athlete-app-jphm.onrender.com",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "window-controls-overlay", "tabbed"],
  "background_color": "#ffffff",
  "theme_color": "#000000",
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "scope": "/",
  "categories": ["sports", "health", "fitness", "analytics"],

  "icons": [
    {
      "src": "/static/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/static/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],

  "shortcuts": [
    {
      "name": "View Dashboard",
      "short_name": "Dashboard",
      "url": "/dashboard",
      "icons": [
        {
          "src": "/static/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "My Performance",
      "short_name": "Performance",
      "url": "/performance"
    }
  ],

  "protocol_handlers": [
    {
      "protocol": "ssa",
      "url": "/profile?user=%s"
    }
  ],

  "launch_handler": {
    "client_mode": "auto"
  },

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*"]
        }
      ]
    }
  },

  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.ssa.app",
      "id": "com.ssa.app"
    }
  ],
  "prefer_related_applications": false,

  "screenshots": [
    {
      "src": "/static/screenshots/screenshot1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "label": "Dashboard"
    },
    {
      "src": "/static/screenshots/screenshot2.png",
      "sizes": "1280x720",
      "type": "image/png",
      "label": "Performance Page"
    },
    {
      "src": "/static/screenshots/screenshot3.png",
      "sizes": "1280x720",
      "type": "image/png",
      "label": "Profile Page"
    },
    {
      "src": "/static/screenshots/screenshot4.png",
      "sizes": "1280x720",
      "type": "image/png",
      "label": "Settings Page"
    }
  ],

  "features": {
    "offline_support": true,
    "periodic_sync": true,
    "background_sync": true,
    "push_notifications": true,
    "widgets": true,
    "edge_side_panel": true,
    "window_controls_overlay": true,
    "tabbed_display": true,
    "note_taking": true
  },

  "file_handlers": [
    {
      "action": "/upload",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg"],
        "application/pdf": [".pdf"]
      }
    }
  ],

  "widgets": [
    {
      "name": "SSA Quick Stats",
      "description": "Shows athlete’s recent performance metrics",
      "src": "/static/widget.html",
      "type": "application/vnd.w3c.widget"
    }
  ],

  "edge_side_panel": {
    "preferred_width": 360,
    "url": "/sidepanel"
  },

  "note_taking": {
    "new_note_url": "/notes/new",
    "targets": [
      {
        "name": "SSA Notes",
        "url": "/notes"
      }
    ]
  }
}
