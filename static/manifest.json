{
  "name": "SSA",
  "short_name": "SSA",
  "description": "Smart Sports Athlete — AI-powered performance tracking and athlete insights.",
  "id": "/",
  "start_url": "https://athlete-app-jphm.onrender.com",
  "scope": "/",
  "scope_extensions": [
    {
      "origin": "https://athlete-app-jphm.onrender.com"
    }
  ],
  "display": "standalone",
  "display_override": [
    "standalone",
    "tabbed",
    "window-controls-overlay"
  ],
  "background_color": "#ffffff",
  "theme_color": "#000000",
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "sports",
    "health",
    "fitness",
    "analytics"
  ],

  "icons": [
    {
      "src": "/static/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/static/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/static/abhinav_profile.jpg",
      "sizes": "256x256",
      "type": "image/jpeg",
      "purpose": "any"
    }
  ],

  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "url": "/dashboard",
      "icons": [
        {
          "src": "/static/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Performance",
      "short_name": "Performance",
      "url": "/performance"
    }
  ],

  "screenshots": [
    {
      "src": "/static/screenshots/screenshot1.png",
      "sizes": "1280x720",
      "type": "image/png"
    },
    {
      "src": "/static/screenshots/screenshot2.png",
      "sizes": "1280x720",
      "type": "image/png"
    }
  ],

  "protocol_handlers": [
    {
      "protocol": "ssa",
      "url": "/profile?user=%s"
    }
  ],

  "launch_handler": {
    "client_mode": "auto"
  },

  "file_handlers": [
    {
      "action": "/upload",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg"]
      }
    }
  ],

  "widgets": [
    {
      "name": "Performance Widget",
      "description": "Quick stats on your recent sessions.",
      "src": "/static/widget.html",
      "type": "application/vnd.w3c.widget",
      "sizes": "320x240"
    }
  ],

  "edge_side_panel": {
    "preferred_width": 380
  },

  "window_controls_overlay": {
    "visible": true
  },

  "iarc_rating_id": "e1234567890",

  "offline_capabilities": {
    "service_worker": "/service-worker.js",
    "resources": ["/", "/dashboard", "/performance", "/static/icon-192x192.png"]
  },

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*"]
        }
      ]
    }
  },

  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.ssa.app",
      "id": "com.ssa.app"
    }
  ],
  "prefer_related_applications": false
}
