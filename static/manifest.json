{
  "name": "SSA",
  "short_name": "SSA",
  "description": "Smart Sports Athlete — AI-powered performance tracking and athlete report cards.",
  "start_url": "https://athlete-app-jphm.onrender.com/",
  "id": "https://athlete-app-jphm.onrender.com/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "fullscreen"
  ],
  "background_color": "#ffffff",
  "theme_color": "#000000",
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "scope": "https://athlete-app-jphm.onrender.com/",
  "categories": [
    "sports",
    "athlete",
    "health",
    "fitness",
    "performance"
  ],
  "icons": [
    {
      "src": "/static/abhinav_profile.jpg",
      "sizes": "192x192",
      "type": "image/jpeg",
      "purpose": "any maskable"
    },
    {
      "src": "/static/abhinav_profile.jpg",
      "sizes": "512x512",
      "type": "image/jpeg",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/static/screenshots/screenshot1.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard Overview"
    },
    {
      "src": "/static/screenshots/screenshot2.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Athlete Performance Graph"
    },
    {
      "src": "/static/screenshots/screenshot3.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Profile and Reports"
    },
    {
      "src": "/static/screenshots/screenshot4.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Activity History"
    }
  ],
  "shortcuts": [
    {
      "name": "View Dashboard",
      "short_name": "Dashboard",
      "url": "/dashboard",
      "icons": [
        {
          "src": "/static/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "My Performance",
      "short_name": "Performance",
      "url": "/performance"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "ssa",
      "url": "/profile?user=%s"
    }
  ],
  "launch_handler": {
    "client_mode": "auto"
  },
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*"]
        }
      ]
    }
  },
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.ssa.app",
      "id": "com.ssa.app"
    }
  ],
  "prefer_related_applications": false
}
