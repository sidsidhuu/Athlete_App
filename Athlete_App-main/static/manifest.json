{
  "name": "SSA",
  "short_name": "SSA",
  "description": "Smart Sports Athlete — AI-powered performance tracking and insights for athletes.",
  "start_url": "https://athlete-app-jphm.onrender.com",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "window-controls-overlay", "tabbed"],
  "background_color": "#ffffff",
  "theme_color": "#000000",
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "scope": "/",
  "categories": ["sports", "health", "fitness", "analytics"],

  "icons": [
    {
      "src": "/static/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/static/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],

  "screenshots": [
    {
      "src": "/static/screenshots/screenshot1.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard Overview"
    },
    {
      "src": "/static/screenshots/screenshot2.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Performance Graphs"
    },
    {
      "src": "/static/screenshots/screenshot3.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Profile Page"
    },
    {
      "src": "/static/screenshots/screenshot4.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Reports View"
    }
  ],

  "shortcuts": [
    {
      "name": "View Dashboard",
      "short_name": "Dashboard",
      "url": "/dashboard",
      "icons": [
        { "src": "/static/icon-192x192.png", "sizes": "192x192" }
      ]
    },
    {
      "name": "My Performance",
      "short_name": "Performance",
      "url": "/performance"
    }
  ],

  "protocol_handlers": [
    {
      "protocol": "ssa",
      "url": "/profile?user=%s"
    }
  ],

  "launch_handler": {
    "client_mode": "auto"
  },

  "file_handlers": [
    {
      "action": "/upload",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg"],
        "application/json": [".json"]
      }
    }
  ],

  "widgets": [
    {
      "name": "SSA Quick Stats",
      "description": "Show your recent performance summary",
      "src": "/widgets/quick-stats.html",
      "type": "text/html",
      "sizes": "320x200"
    }
  ],

  "edge_side_panel": {
    "preferred_width": 480
  },

  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.ssa.app",
      "id": "com.ssa.app"
    }
  ],
  "prefer_related_applications": false,

  "permissions": {
    "periodic-background-sync": {},
    "background-sync": {},
    "notifications": {},
    "push": {},
    "background-fetch": {}
  },

  "features": {
    "offline": true,
    "push_notifications": true,
    "background_sync": true,
    "periodic_sync": true
  },

  "scope_extensions": [
    {
      "origin": "https://athlete-app-jphm.onrender.com"
    }
  ]
}
